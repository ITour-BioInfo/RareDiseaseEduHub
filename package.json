{
  "name": "rare-disease-education-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "preview": "tsx scripts/serve-dist.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "cross-env ASTRO_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=6144 astro check && tsc --noEmit",
    "catalog:migrate": "tsx scripts/migrate.ts",
    "catalog:validate": "tsx scripts/validate.ts",
    "catalog:export": "tsx scripts/export.ts",
    "catalog:build": "pnpm catalog:validate && pnpm catalog:export && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "translations:validate": "tsx scripts/validate-translations.ts",
    "report:translations": "tsx scripts/validate-translations.ts --report",
    "monitor:morning": "tsx automation/cli.ts morning",
    "monitor:priority": "tsx automation/cli.ts priority",
    "monitor:record": "tsx automation/cli.ts record",
    "monitor:fixtures": "tsx automation/cli.ts fixtures",
    "monitor:dry-run": "tsx automation/cli.ts dry-run",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/integration",
    "test:browser": "playwright test tests/browser",
    "test:a11y": "playwright test tests/accessibility",
    "test:crawler": "vitest run tests/integration/crawler.test.ts",
    "build": "pnpm catalog:validate && pnpm translations:validate && pnpm catalog:export && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check:exports": "tsx scripts/check-exports.ts",
    "check:links": "tsx scripts/check-links.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm catalog:validate && pnpm translations:validate && pnpm check:exports && pnpm test && pnpm build"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.2.6",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.2",
    "cross-env": "10.1.0",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "3.1.0",
    "fast-glob": "3.3.3",
    "globals": "17.11.0",
    "happy-dom": "20.11.6",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
