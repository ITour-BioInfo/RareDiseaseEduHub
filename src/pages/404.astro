---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/translate';
import { withBase } from '../lib/site/url';
---

<BaseLayout locale="en" title={`${t('en', '404.title')} · ${t('en', 'site.title')}`} noindex>
  <section class="not-found shell narrow">
    <p class="error-code">404</p><h1>{t('en', '404.title')}</h1><p>{t('en', '404.body')}</p><a
      class="button primary"
      href={withBase('/')}>{t('en', '404.home')}</a
    >
  </section>
</BaseLayout>
