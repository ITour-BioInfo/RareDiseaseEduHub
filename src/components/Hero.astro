---
import type { Locale } from '../i18n/config';
import { route } from '../i18n/routes';
import { t } from '../i18n/translate';
import { withBase } from '../lib/site/url';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section class="hero">
  <div class="hero-orbit orbit-one" aria-hidden="true"></div><div
    class="hero-orbit orbit-two"
    aria-hidden="true"
  >
  </div>
  <div class="shell hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{t(locale, 'hero.eyebrow')}</p>
      <h1>{t(locale, 'hero.title')}</h1>
      <p class="hero-body">{t(locale, 'hero.body')}</p>
      <div class="hero-actions">
        <a class="button primary" href="#catalogue">{t(locale, 'hero.browse')}</a><a
          class="button ghost"
          href={withBase(route(locale, 'methodology'))}>{t(locale, 'hero.methodology')}</a
        >
      </div>
    </div>
    <div class="hero-panel" aria-hidden="true">
      <div class="signal-card signal-a"><span></span><span></span><span></span></div>
      <div class="signal-card signal-b"><strong>180</strong><i></i><i></i></div>
      <div class="signal-card signal-c"><b></b><b></b><b></b><b></b></div>
    </div>
  </div>
</section>
