---
import type { Locale } from '../i18n/config';
import { t } from '../i18n/translate';
import type { CatalogRecord } from '../lib/catalog/schema';
import { STATUS_CODES } from '../lib/catalog/status';
interface Props {
  locale: Locale;
  records: CatalogRecord[];
}
const { locale, records } = Astro.props;
const types = [...new Set(records.map((record) => record.classification.resource_type))].sort();
---

<form class="filters" data-catalogue-filters aria-labelledby="filters-heading">
  <div class="filters-title-row">
    <h3 id="filters-heading">{t(locale, 'filters.heading')}</h3>
    <button class="clear-button" type="reset">{t(locale, 'filters.clear')}</button>
  </div>
  <div class="filter-grid">
    <label class="search-field"
      ><span>{t(locale, 'filters.search')}</span><input
        type="search"
        name="q"
        placeholder={t(locale, 'filters.searchPlaceholder')}
        autocomplete="off"
      /></label
    >
    <label
      ><span>{t(locale, 'filters.resourceType')}</span><select name="type"
        ><option value="">{t(locale, 'filters.all')}</option>{
          types.map((value) => <option value={value}>{t(locale, `type.${value}`)}</option>)
        }</select
      ></label
    >
    <label
      ><span>{t(locale, 'filters.status')}</span><select name="status"
        ><option value="">{t(locale, 'filters.all')}</option>{
          STATUS_CODES.map((value) => <option value={value}>{t(locale, `status.${value}`)}</option>)
        }</select
      ></label
    >
  </div>
  <div class="active-filters" data-active-filters aria-label={t(locale, 'filters.active')}></div>
</form>
